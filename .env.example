# 复制为 .env 后按部署实际值修改；.env 已被 git / docker build context 忽略。
# 演示站账号（demo-site 与 hydro-collector 共用这一组）
DEMO_USERNAME=hydro
DEMO_PASSWORD=hydro-demo-pass
# 0 表示不按时间自动失效（仍可通过 /expire 手动失效）
DEMO_SESSION_TTL_SECONDS=0

# 采集端的登录站点配置（Docker Compose 内部地址；本地运行见 run_dev.sh）
HYDRO_LOGIN_URL=http://demo-site:8080/login
HYDRO_AUTH_URL=http://demo-site:8080/daily
HYDRO_EXPIRE_URL=http://demo-site:8080/expire
HYDRO_USERNAME=hydro
HYDRO_PASSWORD=hydro-demo-pass
HYDRO_CSRF_FIELD=csrf_token
# HYDRO_USER_FIELD=username
# HYDRO_PASSWORD_FIELD=password
# HYDRO_HTTP_TIMEOUT=15
